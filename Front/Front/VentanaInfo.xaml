<Window x:Class="Front.VentanaInfo"
        ResizeMode="NoResize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Front"
        mc:Ignorable="d"
        Title="VentanaInfo" Height="100" Width="300">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="White"/>
                <GradientStop Color="#66FFEE00" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Image x:Name="imgRecursos_Copy1" HorizontalAlignment="Left" Margin="151,0,0,0" Width="82" Source="/recursos/depredador.png" VerticalAlignment="Center" Height="71" RenderTransformOrigin="0.51,0.654"/>
        <Image x:Name="imghormiga1" HorizontalAlignment="Left" Height="68" Margin="5,4,0,0" VerticalAlignment="Top" Width="75" Source="/recursos/HormigaSalir.png"/>
        <TextBlock x:Name="txtHormigas" HorizontalAlignment="Left" Margin="88,32,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="39" Width="62"/>
        <TextBlock x:Name="txtDepredadores" HorizontalAlignment="Left" Margin="229,33,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="39" Width="62"/>

    </Grid>
</Window>
