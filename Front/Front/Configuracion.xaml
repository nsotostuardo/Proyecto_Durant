<Window x:Class="Front.Configuracion"
        ResizeMode="NoResize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Front"
        mc:Ignorable="d"
        Title="Configuracion" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" SpreadMethod="Pad" Opacity="0.605">
                <GradientStop Color="White" Offset="0"/>
                <GradientStop Color="#FF00C8FF" Offset="0.86"/>
                <GradientStop Color="White" Offset="0.342"/>
                <GradientStop Color="#FF00C8FF" Offset="0.768"/>
            </LinearGradientBrush>
        </Grid.Background>
        <TextBlock x:Name="txtConfiguracion" HorizontalAlignment="Center" Margin="0,30,0,0" TextWrapping="Wrap" Text="Configuración" FontSize="24" Width="160" Height="41" VerticalAlignment="Top"/>
        <TextBlock Margin="117,98,95,0" TextWrapping="Wrap" Text="Edite el tipo de hormiga a usar y/o variables globales." FontSize="24" Height="70" VerticalAlignment="Top"/>
        <Button x:Name="btnHormigas" Content="Hormigas" Margin="82,217,527,0" Background="#FF2D2929" Foreground="White" FontSize="22" Click="btnHormigas_Click" Height="40" VerticalAlignment="Top"/>
        <Button x:Name="btnConstantes" Content="Constantes" Margin="506,221,103,0" Background="#FF2D2929" Foreground="White" FontSize="22" Click="btnConstantes_Click" Height="40" VerticalAlignment="Top"/>
        <Button x:Name="btnSimular" Content="Simular" Margin="303,332,306,0" Background="#FF2D2929" Foreground="White" FontSize="22" Click="btnSimular_Click" Height="40" VerticalAlignment="Top"/>
        <Button x:Name="btnVolver" Content="X" Margin="761,22,0,0" Background="#FFD5CECE" BorderBrush="White" Foreground="#FF747070" SnapsToDevicePixels="True" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Click="btnVolver_Click"/>

    </Grid>
</Window>
