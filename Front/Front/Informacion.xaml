<Window x:Class="Front.Informacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Front"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Informacion" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="White" Offset="0.143"/>
                <GradientStop Color="#33FB2DFE" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <TextBlock x:Name="txtConfiguracion" HorizontalAlignment="Left" Margin="257,34,0,0" TextWrapping="Wrap" FontSize="24" Width="316" Height="41" VerticalAlignment="Top"><Run Text="Informac"/><Run Language="es-cl" Text="ión de"/><Run Language="es-cl" Text="l "/><Run Text="a simulación"/></TextBlock>
        <Image x:Name="imghormiga1_Copy1" HorizontalAlignment="Left" Height="94" Margin="156,109,0,0" VerticalAlignment="Top" Width="88" Source="/632 2.png" Stretch="Fill"/>
        <Image x:Name="imgRecursos_Copy" HorizontalAlignment="Left" Height="74" Margin="163,222,0,0" VerticalAlignment="Top" Width="65" Source="/ambiente.png"/>
        <Image x:Name="imgRecursos_Copy1" HorizontalAlignment="Left" Margin="151,0,0,46" Width="84" Source="/depredador.png" VerticalAlignment="Bottom" Height="76" Stretch="Fill"/>
        <TextBlock x:Name="txtConfiguracion_Copy" HorizontalAlignment="Left" Margin="276,138,0,0" TextWrapping="Wrap" FontSize="24" Width="253" Height="31" VerticalAlignment="Top"><Run Language="es-cl" Text="Hormiga seleccionada"/><Run Text=":"/></TextBlock>
        <TextBlock x:Name="txtConfiguracion_Copy1" HorizontalAlignment="Left" Margin="306,240,0,0" TextWrapping="Wrap" FontSize="24" Width="207" Height="31" VerticalAlignment="Top" Text="Clima seleccionada:"/>
        <TextBlock x:Name="txtConfiguracion_Copy2" HorizontalAlignment="Left" Margin="249,333,0,0" TextWrapping="Wrap" FontSize="24" Width="281" Height="31" VerticalAlignment="Top" Text="Depredador seleccionado:"/>
        <TextBlock x:Name="txtHormigaselect" HorizontalAlignment="Left" Margin="538,136,0,0" TextWrapping="Wrap" FontSize="24" Width="253" Height="31" VerticalAlignment="Top" Text="default"/>
        <TextBlock x:Name="txtClimaselect" HorizontalAlignment="Left" Margin="536,244,0,0" TextWrapping="Wrap" FontSize="24" Width="253" Height="31" VerticalAlignment="Top" Text="default"/>
        <TextBlock x:Name="txtDepredaroselect" HorizontalAlignment="Left" Margin="545,333,0,0" TextWrapping="Wrap" FontSize="24" Width="253" Height="31" VerticalAlignment="Top" Text="default"/>
        <Button x:Name="btnVolver" Content="X" Margin="761,22,0,0" Background="#FFD5CECE" BorderBrush="White" Foreground="#FF747070" SnapsToDevicePixels="True" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Click="btnVolver_Click"/>

    </Grid>
</Window>
