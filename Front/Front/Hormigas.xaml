<Window x:Class="Front.Hormigas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Front"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Hormigas" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnVolver" Content="X" Margin="761,22,0,0" Background="#FFD5CECE" BorderBrush="White" Foreground="#FF747070" SnapsToDevicePixels="True" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Click="btnVolver_Click"/>
        <TextBlock x:Name="txtHormigas" Margin="261,23,0,0" TextWrapping="Wrap" Text="Seleccione el tipo de hormiga" FontSize="24" Height="70" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="Black"/>
        <Image x:Name="imghormiga1" HorizontalAlignment="Left" Height="107" Margin="243,76,0,0" VerticalAlignment="Top" Width="103" Source="/recursos/hormiga1.png"/>
        <Image x:Name="imghormiga1_Copy" HorizontalAlignment="Left" Height="107" Margin="242,172,0,0" VerticalAlignment="Top" Width="103" Source="/recursos/hormiga2.png"/>
        <Image x:Name="imghormiga1_Copy1" HorizontalAlignment="Left" Height="107" Margin="243,273,0,0" VerticalAlignment="Top" Width="103" Source="/recursos/hormiga3.png"/>
        <TextBlock HorizontalAlignment="Left" Margin="267,376,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="22"><Run Text="Seleccionada:"/><LineBreak/><Run/></TextBlock>
        <TextBlock x:Name="txtTipoHormiga" HorizontalAlignment="Left" Margin="407,376
                   ,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="22" Width="224"><Run Language="ja-jp" Text="defecto"/><LineBreak/><Run/></TextBlock>
        <Button x:Name="btnCamponotus" Content="Camponotus" HorizontalAlignment="Left" Margin="416,115,0,0" VerticalAlignment="Top" Height="38" Width="193" Background="{x:Null}" FontSize="22" BorderThickness="2,2,2,2" Click="btnCamponotus_Click"/>
        <Button x:Name="btnBala" Content="Hormiga Bala" HorizontalAlignment="Left" Margin="416,200,0,0" VerticalAlignment="Top" Height="38" Width="193" Background="{x:Null}" FontSize="22" BorderThickness="2,2,2,2" Click="btnBala_Click"/>
        <Button x:Name="btnHoja" Content="Hormiga de la hoja" HorizontalAlignment="Left" Margin="416,295,0,0" VerticalAlignment="Top" Height="38" Width="193" Background="{x:Null}" FontSize="22" BorderThickness="2,2,2,2" Click="btnHoja_Click"/>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="White" Offset="0.155"/>
                <GradientStop Color="#66FFEE00" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
    </Grid>
</Window>
