<Window x:Class="Front.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Front"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="MainWindow" Height="450" Width="800" Background="#FF969696">
    <Grid>
        <Rectangle Margin="45,24,41,32" Stroke="Black" Fill="White"/>
        <Image Height="220" Margin="245,40,236,0" VerticalAlignment="Top" Source="/logo.jpg" RenderTransformOrigin="0.511,0.553" Stretch="Fill"/>
        <Button x:Name="btnIniciar" Content="Iniciar Similación" Margin="293,257,283,0" VerticalAlignment="Top" Height="52" FontSize="22" Background="#FF5AA4FF" Foreground="White" Click="btnIniciar_Click"/>
        <Button x:Name="btnSalir" Content="Salir" Margin="331,331,312,0" VerticalAlignment="Top" Height="40" Foreground="White" Background="Red" BorderBrush="#FF5F0000" FontSize="18" Click="btnSalir_Click"/>

    </Grid>
</Window>
